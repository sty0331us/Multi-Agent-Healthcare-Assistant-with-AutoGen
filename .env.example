# OpenAI (or compatible) API key — required
OPENAI_API_KEY=sk-your-key-here

# Model configuration
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2

# Optional: alternate providers via AG2 LLMConfig
# ANTHROPIC_API_KEY=

# HITL (Human-in-the-Loop) gate
HITL_ENABLED=true
HITL_REQUIRE_APPROVAL_FOR_TREATMENT=true
HITL_REQUIRE_APPROVAL_FOR_MENTAL_HEALTH=true

# Medical data sources (optional; mock used when unset)
# FDA_API_KEY=
# NIH_API_BASE=https://clinicaltables.nlm.nih.gov/api

# Runtime
LOG_LEVEL=INFO
MAX_GROUP_CHAT_ROUNDS=12
